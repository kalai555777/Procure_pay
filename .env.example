# Copy to .env and set your own values. .env is never committed.
# The superuser: only the setup service and the tests' rebuilds use it.
POSTGRES_USER=clearbuy
POSTGRES_PASSWORD=change-me
POSTGRES_DB=clearbuy
# Each role's password: set your own random values (hex, no $).
CLEARBUY_OWNER_PASSWORD=
CLEARBUY_TASKS_PASSWORD=
CLEARBUY_SETTINGS_PASSWORD=
CLEARBUY_EXAMPLE_PASSWORD=
